{"data": {"conn_name": "macro_log_macro_results", "sql": "select\n    elementary_test_results_id,\n    result_row\n  from jnadal_db.elementary.test_result_rows\n  where datediff(\n        day,\n        cast(detected_at as timestamp),\n        \n  current_timestamp::timestamp\n\n        ) < 7\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from jnadal_db.elementary.ordered_test_results__tmp_20260923021925868330\n        where invocations_rank_index = 1\n    )\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"6b1c4396-1ea4-4e24-802c-73e4a04499e7\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"profile_name\": \"elementary\", \"target_name\": \"prod\", \"connection_name\": \"macro_log_macro_results\"} */"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "6b1c4396-1ea4-4e24-802c-73e4a04499e7", "level": "debug", "msg": "On macro_log_macro_results: select\n    elementary_test_results_id,\n    result_row\n  from jnadal_db.elementary.test_result_rows\n  where datediff(\n        day,\n        cast(detected_at as timestamp),\n        \n  current_timestamp::timestamp\n\n        ) < 7\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from jnadal_db.elementary.ordered_test_results__tmp_20260923021925868330\n        where invocations_rank_index = 1\n    )\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"6b1c4396-1ea4-4e24-802c-73e4a04499e7\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"profile_name\": \"elementary\", \"target_name\": \"prod\", \"connection_name\": \"macro_