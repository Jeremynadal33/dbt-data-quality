{"data": {"conn_name": "macro_log_macro_results", "sql": "select\n    elementary_test_results_id,\n    result_row\n  from jnadal_db.elementary.test_result_rows\n  where datediff(\n        day,\n        cast(detected_at as timestamp),\n        \n  current_timestamp::timestamp\n\n        ) < 7\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from jnadal_db.elementary.ordered_test_results__tmp_20260920021409197238\n        where invocations_rank_index = 1\n    )\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"b085d507-b26e-4f01-9001-43146524025b\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"profile_name\": \"elementary\", \"target_name\": \"prod\", \"connection_name\": \"macro_log_macro_results\"} */"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "b085d507-b26e-4f01-9001-43146524025b", "level": "debug", "msg": "On macro_log_macro_results: select\n    elementary_test_results_id,\n    result_row\n  from jnadal_db.elementary.test_result_rows\n  where datediff(\n        day,\n        cast(detected_at as timestamp),\n        \n  current_timestamp::timestamp\n\n        ) < 7\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from jnadal_db.elementary.ordered_test_results__tmp_20260920021409197238\n        where invocations_rank_index = 1\n    )\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"b085d507-b26e-4f01-9001-43146524025b\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"profile_name\": \"elementary\", \"target_name\": \"prod\", \"connection_name\": \"macro_